rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: news
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required, max 200 chars)
    //   - slug: string (required, max 200 chars)
    //   - category: string (required, max 50 chars)
    //   - teaser: string (required, max 300 chars)
    //   - content: string (required, max 50000 chars)
    //   - tags: list of strings (optional, max 10 items, max 30 chars each)
    //   - imageUrl: string (optional, valid URL)
    //   - imageAttribution: string (optional, max 200 chars)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "agungdj99@komnaspplh.org";
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidUrl(url) {
      return url is string &&
        (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    function isValidTags(tags) {
      return tags is list && tags.size() <= 10;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidNewsArticle() {
      let allowedFields = ['title', 'slug', 'category', 'teaser', 'content', 'tags', 'imageUrl', 'imageAttribution', 'createdAt'];
      
      return hasRequiredFields(['title', 'slug', 'category', 'teaser', 'content', 'createdAt']) &&
             hasOnlyAllowedFields(allowedFields) &&
             validStringLength('title', 1, 200) &&
             validStringLength('slug', 1, 200) &&
             validStringLength('category', 1, 50) &&
             validStringLength('teaser', 1, 300) &&
             validStringLength('content', 1, 50000) &&
             request.resource.data.createdAt is timestamp &&
             (!('tags' in request.resource.data) || isValidTags(request.resource.data.tags)) &&
             (!('imageUrl' in request.resource.data) || isValidUrl(request.resource.data.imageUrl)) &&
             (!('imageAttribution' in request.resource.data) || validStringLength('imageAttribution', 0, 200));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /news/{newsId} {
      // Publicly readable
      allow read: if true;
      
      // Only admin can write
      allow create: if isAdmin() && isValidNewsArticle();
      allow update: if isAdmin() && isValidNewsArticle();
      allow delete: if isAdmin();
    }
    
    match /reports/{reportId} {
      // Anyone can submit a report
      allow create: if true;
      
      // Only admin can read reports for privacy
      allow read: if isAdmin();
      
      allow update, delete: if isAdmin();
    }
  }
}
